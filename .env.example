# Copy this file to .env.local and fill it in. .env.local stays on your computer.

# Storyblok, read access. Settings → Access Tokens → the "Preview" token.
# Also add this one on Vercel (Project → Settings → Environment Variables).
STORYBLOK_DELIVERY_API_TOKEN=<PREVIEW_TOKEN>
# eu, us, ca or ap
STORYBLOK_REGION=eu

# Storyblok, write access. Only for `npm run storyblok:setup` and `npm run blog:push`
# on your own computer; never add these to Vercel.
# My account → Account settings → Personal access tokens. Space ID: Settings → Space.
STORYBLOK_MANAGEMENT_TOKEN=<PERSONAL_ACCESS_TOKEN>
STORYBLOK_SPACE_ID=<SPACE_ID>

# Optional, on Vercel: refresh the site as soon as you publish (see README).
STORYBLOK_WEBHOOK_SECRET=<RANDOM_STRING>

# The public URL of the site, for the sitemap and social previews.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
