# ── Storyblok (read) ─────────────────────────────────────────────
# Settings → Access Tokens. Use the *preview* token so drafts work in the Visual Editor.
# Server-side only — it is never sent to the browser.
STORYBLOK_DELIVERY_API_TOKEN=<REPLACE_WITH_YOUR_TOKEN>
STORYBLOK_API_BASE_URL=https://api.storyblok.com
STORYBLOK_REGION=eu

# Visual Editor on production: preview URL = https://<domain>/api/draft?secret=<this>&slug=
STORYBLOK_PREVIEW_SECRET=<RANDOM_STRING>
# Webhook (Story published/unpublished): https://<domain>/api/revalidate?secret=<this>
STORYBLOK_WEBHOOK_SECRET=<RANDOM_STRING>

# ── Storyblok (write) — local scripts only, never add these to Vercel ──
# `npm run storyblok:setup` and `npm run blog:push`
# My account → Personal access tokens. Space ID: Settings → Space.
STORYBLOK_MANAGEMENT_TOKEN=<PERSONAL_ACCESS_TOKEN>
STORYBLOK_SPACE_ID=<SPACE_ID>

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# ── Contact form (Resend — https://resend.com) ───────────────────
RESEND_API_KEY=<RESEND_API_KEY>
# Where messages are delivered (comma separated for multiple)
CONTACT_TO_EMAIL=hello@your-domain.com
# A sender on a domain you verified in Resend
CONTACT_FROM_EMAIL=Portfolio <portfolio@your-domain.com>
